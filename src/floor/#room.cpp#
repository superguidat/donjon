#include "room.hh"

bool room::isMinimal() const
{
  int sizex = corner[3].x - corner[0].x;
  int sizey = corner[3].y - corner[0].y;

  if (sizex * sizey < (minsize / 4) * (minsize / 4))
    return (true);
  if (sizex < minsize)
    return true;
  if(sizey < minsize)
    return true;
  return false;
}
